# Public repository allowlist. Local plans, tooling, evidence, and machine
# configuration stay in the workspace but are not part of the Git surface.
*

!.gitignore
!README.MD

!backend/
!backend/**

!web_app/
!web_app/**

!android_app/
!android_app/**

android_app/.gradle/
android_app/.kotlin/
android_app/**/build/
android_app/local.properties
android_app/**/.DS_Store
android_app/**/*.jks
android_app/**/*.keystore

**/.DS_Store

!ios_app/
!ios_app/**
ios_app/build/
ios_app/**/xcuserdata/
ios_app/**/*.xcuserstate
ios_app/**/*.mobileprovision
ios_app/**/*.p12
